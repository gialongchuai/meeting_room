# ==============================================================================
# MEETING ROOM BOOKING SERVICE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# HƯỚNG DẪN:
# 1. Tạo file .env từ file mẫu này:
#    cp .env.example .env
# 2. Điền các giá trị thực tế thay thế cho các chuỗi placeholder (change-me-...).
# 3. Để sinh khóa bí mật ngẫu nhiên bảo mật cao cho JWT_SECRET, chạy lệnh:
#    openssl rand -base64 48
# ==============================================================================

# Database Configuration
POSTGRES_DB=meeting_room
POSTGRES_PORT=5432
SPRING_DATASOURCE_USERNAME=postgres
# BẮT BUỘC: Thay thế bằng mật khẩu mạnh thực tế cho database
SPRING_DATASOURCE_PASSWORD=change-me-db-password

# Application Port
PORT=8080

# JWT Authentication
# BẮT BUỘC: Chuỗi bí mật HMAC-SHA tối thiểu 32 byte (gợi ý: openssl rand -base64 48)
JWT_SECRET=change-me-to-a-secure-random-secret-key-at-least-32-bytes
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7

# Default Administrator Account (Seeded on first startup)
# BẮT BUỘC: Email và mật khẩu quản trị viên mặc định
APP_ADMIN_EMAIL=admin@company.com
# Mật khẩu tối thiểu 8 ký tự, phải gồm cả chữ cái và chữ số
APP_ADMIN_PASSWORD=change-me-Admin@123456

# Business Timezone & Demo Seed
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_SEED_DEMO_DATA=true
CORS_ALLOWED_ORIGINS=*

# Booking Business Rules
BOOKING_MIN_DURATION_MINUTES=15
BOOKING_MAX_DURATION_MINUTES=240
BOOKING_TIME_SLOT_STEP_MINUTES=15
BOOKING_MAX_LEAD_DAYS=60
BOOKING_WORKING_HOURS_START=08:00
BOOKING_WORKING_HOURS_END=18:00
BOOKING_QUOTA_PER_USER=20
